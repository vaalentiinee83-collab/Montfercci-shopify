</nav>

<section class="hero">

  <div class="configurateur">

    <!-- Flèches gauche — une par pièce, alignées -->
    <div class="arrows-fixed left">
      <button class="piece-arr" onclick="prev('tie')">&#8592;</button>
      <button class="piece-arr" onclick="prev('jacket')">&#8592;</button>
      <button class="piece-arr" onclick="prev('pants')">&#8592;</button>
    </div>

    <!-- Flèches droite -->
    <div class="arrows-fixed right">
      <button class="piece-arr" onclick="next('tie')">&#8594;</button>
      <button class="piece-arr" onclick="next('jacket')">&#8594;</button>
      <button class="piece-arr" onclick="next('pants')">&#8594;</button>
    </div>

    <!-- Cravate -->
    <div class="piece-row row-tie">
      <div class="scene">
        <div class="ring" id="ring-tie"></div>
