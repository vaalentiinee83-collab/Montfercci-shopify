      <div class="form-group"><input type="text" id="nom" placeholder="Nom" autocomplete="family-name"></div>
      <div class="form-group"><input type="email" id="email" placeholder="Adresse e-mail" autocomplete="email"></div>
      <div class="rgpd-row">
        <input type="checkbox" id="rgpd">
