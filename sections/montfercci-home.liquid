      </div>
      <button class="btn-submit" onclick="handleSubmit()">Être alertée du lancement</button>
    </div>
    <div class="confirmation-msg" id="confirmMsg">
      <p>Merci. Nous vous contacterons en avant-première.</p>
    </div>
