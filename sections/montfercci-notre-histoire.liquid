<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Montserrat:wght@300;400&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:#fff;color:#0a0a0a;font-family:'Lora',serif;font-weight:400;overflow-x:hidden}

header{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:12px 48px;display:flex;align-items:center;justify-content:center;
  border-bottom:1px solid rgba(51,51,51,.15);
  background:rgba(255,255,255,.92);backdrop-filter:blur(12px);
  animation:slideDown .8s ease forwards;
}
.logo-link{text-decoration:none;display:flex;flex-direction:column;align-items:center;justify-content:center}
.logo-img{height:50px;width:auto;display:block}
.logo-tagline{display:block;font-family:'Cormorant Garamond',serif;font-size:10px;letter-spacing:.2em;color:#555;margin-top:4px}
.burger{position:absolute;right:24px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;display:flex;flex-direction:column;gap:5px;padding:8px;z-index:110}
.burger span{display:block;width:22px;height:1px;background:#0a0a0a;transition:all .3s ease}
.dropdown-menu{position:fixed;top:0;right:0;width:260px;height:100vh;background:#fff;z-index:105;display:flex;flex-direction:column;justify-content:flex-start;padding:100px 40px 48px;transform:translateX(100%);transition:transform .4s cubic-bezier(.77,0,.175,1)}
.dropdown-menu.open{transform:translateX(0)}
.dropdown-menu a{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:300;letter-spacing:.06em;color:#0a0a0a;text-decoration:none;padding:14px 0;border-bottom:1px solid rgba(51,51,51,.1);cursor:pointer;transition:opacity .2s}
.dropdown-menu a:last-child{border-bottom:none}
.dropdown-menu a:hover{opacity:.4}
.menu-overlay{position:fixed;inset:0;background:rgba(0,0,0,.2);z-index:104;opacity:0;pointer-events:none;transition:opacity .4s}
.menu-overlay.open{opacity:1;pointer-events:all}

.page-content{padding-top:80px;min-height:100vh}

.histoire-hero{
  text-align:center;
  padding:16px 48px 20px;
  max-width:780px;
  margin:0 auto;
  animation:fadeUp 1.1s .2s ease both;
}
.histoire-hero h1{
  font-family:'Lora',serif;
  font-size:clamp(1.2rem,3vw,1.8rem);
  font-weight:600;
  letter-spacing:.04em;
  margin-bottom:20px;
  line-height:1.3;
}
.histoire-hero .sous-titre{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  font-size:clamp(1rem,2.5vw,1.3rem);
  font-weight:300;
  color:#555;
  letter-spacing:.04em;
  line-height:1.6;
}

.separateur{
  width:40px;
  height:1px;
  background:#0a0a0a;
  margin:16px auto;
  animation:fadeIn 1s .6s ease both;
}

.section-texte{
  max-width:620px;
  margin:0 auto;
  padding:0 48px 80px;
  animation:fadeUp 1.1s .4s ease both;
}
.section-texte p{
  font-family:'Lora',serif;
  font-size:clamp(.9rem,1.8vw,1.05rem);
  font-weight:400;
  line-height:1.9;
  letter-spacing:.01em;
  color:#1a1a1a;
  margin-bottom:28px;
}
.section-texte p:last-child{margin-bottom:0}
.section-sous-titre{
  font-family:'Montserrat',sans-serif !important;
  font-size:.58rem !important;
  letter-spacing:.4em !important;
  text-transform:uppercase;
  color:#0a0a0a !important;
  margin-top:40px !important;
  margin-bottom:8px !important;
  line-height:1.4 !important;
}

.citation{
  text-align:center;
  padding:60px 48px;
  background:#fff;
  animation:fadeIn 1s .5s ease both;
}
.citation blockquote{
  font-family:'Cormorant Garamond',serif;
  font-style:italic;
  font-size:clamp(1.2rem,3vw,1.7rem);
  font-weight:300;
  letter-spacing:.05em;
  color:#0a0a0a;
  max-width:600px;
  margin:0 auto;
  line-height:1.7;
}
.citation cite{
  display:block;
  margin-top:20px;
  font-family:'Montserrat',sans-serif;
  font-size:.58rem;
  letter-spacing:.3em;
  text-transform:uppercase;
  color:#888;
  font-style:normal;
}

.valeurs{
  max-width:780px;
  margin:0 auto;
  padding:80px 48px;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:48px;
  animation:fadeUp 1.1s .5s ease both;
}
.valeur{text-align:center}
.valeur-titre{
  font-family:'Montserrat',sans-serif;
  font-size:.58rem;
  letter-spacing:.4em;
  text-transform:uppercase;
  margin-bottom:16px;
}
.valeur-texte{
  font-family:'Cormorant Garamond',serif;
  font-size:.95rem;
  line-height:1.7;
  color:#555;
}

footer{border-top:1px solid rgba(51,51,51,.12);padding:36px 48px 32px;display:flex;flex-direction:column;align-items:center;gap:22px;animation:fadeIn 1.2s 1.2s ease both}
.footer-label{font-size:.6rem;letter-spacing:.4em;color:#0a0a0a;text-transform:uppercase;text-align:center}
.social-links{display:flex;gap:16px}
.social-link{display:flex;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid rgba(51,51,51,.25);border-radius:50%;color:#0a0a0a;text-decoration:none;transition:all .3s}
.social-link:hover{border-color:#0a0a0a}
.social-link svg{width:18px;height:18px}
.footer-bottom{font-size:.56rem;letter-spacing:.2em;color:#0a0a0a;text-transform:uppercase;text-align:center}

@keyframes fadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}

@media(max-width:480px){
  header{padding:12px 24px}
  .histoire-hero{padding:60px 24px 40px}
  .section-texte{padding:0 24px 60px}
  .valeurs{grid-template-columns:1fr;gap:36px;padding:60px 24px}
  .citation{padding:48px 24px}
  footer{padding:36px 24px 32px}
}
</style>


<header>
  <a href="/" class="logo-link">
    <img src="{{ 'montfercci-logo.png' | asset_url }}" class="logo-img" alt="Montfercci Paris">
    <span class="logo-tagline">Habiller l'ambition.</span>
  </a>
  <button class="burger" id="burger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</header>
<div class="menu-overlay" id="menuOverlay"></div>
<nav class="dropdown-menu" id="dropdownMenu">
  <a href="/">Nos Tieleurs</a>
  <a href="/pages/notre-histoire">Notre Histoire</a>
</nav>

<main class="page-content">

  <div class="histoire-hero">
    <h1>Un erasmus en Italie, une rencontre et une évidence.</h1>
  </div>

  <div class="separateur"></div>

  <div class="section-texte">
    <p>Tout a commencé en Italie du sud, par une rencontre et un constat partagé.</p>
    <p>Thaïs et Valentine découvrent qu'elles partagent la même frustration : impossible de trouver un tailleur féminin, structuré, et à leur taille.</p>
    <p>Trop long, trop court, trop large, jamais pensé pour nous.</p>
    <p>De cette évidence est née MONTFERCCI Paris, avec une ambition claire : redonner au tailleur sa fonction première, celle d'épouser parfaitement la silhouette et apporter confiance aux femmes.</p>
    <p>Avec comme concept, le Tieleur, pièce signature de la maison. Un tailleur avec cravate, symbole de pouvoir longtemps réservé aux hommes, repensé en apportant un style féminin.</p>
    <p>Nous travaillons avec des tissus italiens et une production au Portugal, reconnus pour leur qualité et leur savoir-faire.</p>
    <p>Car pour nous, bien s'habiller ne devrait jamais être une contrainte.</p>
  </div>

  <div class="citation">
    <blockquote>
      « Osez le porter. Devenez la femme que vous voulez être. Affirmez-vous. »
      <cite>Montfercci Paris</cite>
    </blockquote>
  </div>

  <div class="valeurs">
    <div class="valeur">
      <p class="valeur-titre">Pour toutes les tailles</p>
      <p class="valeur-texte">Des coupes pensées pour chaque morphologie, des petites aux grandes tailles.</p>
    </div>
    <div class="valeur">
      <p class="valeur-titre">Rapport qualité-prix</p>
      <p class="valeur-texte">Des matières soigneusement sélectionnées, à un prix accessible et honnête.</p>
    </div>
  </div>

</main>

<footer>
  <p class="footer-bottom">© 2026 Montfercci Paris — <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="dab9b5b4aebbb9ae9ab7b5b4aebcbfa8b9b9b3f4b9b5b7">[email&#160;protected]</a></p>
</footer>


<script>
const burger = document.getElementById('burger');
const menu = document.getElementById('dropdownMenu');
const overlay = document.getElementById('menuOverlay');
burger.addEventListener('click', () => {
  menu.classList.toggle('open');
  overlay.classList.toggle('open');
  burger.classList.toggle('open');
});
overlay.addEventListener('click', () => {
  menu.classList.remove('open');
  overlay.classList.remove('open');
  burger.classList.remove('open');
});
document.querySelectorAll('#dropdownMenu a').forEach(a => {
  a.addEventListener('click', () => {
    menu.classList.remove('open');
    overlay.classList.remove('open');
    burger.classList.remove('open');
  });
});
</script>

{% schema %}
{
  "name": "MONTFERCCI Notre Histoire",
  "tag": "section"
}
{% endschema %}
